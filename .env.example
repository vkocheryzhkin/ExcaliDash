# Copy to .env next to docker-compose.yml. Docker Compose interpolates these
# values into the compose file (they are not automatically injected into every
# container unless listed under that service's environment:).

# Public origin users type in the browser. Must match exactly (https, no path).
FRONTEND_URL=https://excalidash.example.com

# Caddy sits in front of frontend nginx, which proxies to the backend.
TRUST_PROXY=1

# Caddy already redirects HTTP to HTTPS. Disable the backend redirect to avoid loops.
ENFORCE_HTTPS_REDIRECT=false

AUTH_MODE=local

# Set fixed secrets on a VPS so sessions survive recreating the backend container.
# JWT_SECRET=change-this-secret-in-production-min-32-chars
# CSRF_SECRET=change-this-secret-in-production

# Let's Encrypt via: docker compose --profile https up -d
# DNS A/AAAA for this hostname must point at the server before the first start.
CADDY_DOMAIN=excalidash.example.com
CADDY_EMAIL=admin@example.com

# With Caddy on :80/:443, keep the internal HTTP frontend off the public interface.
FRONTEND_BIND=127.0.0.1
